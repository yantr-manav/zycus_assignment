# Copy this file to .env and paste your credentials locally. Never commit .env.
# At least one provider is required; the router uses whichever are configured.
# Multiple keys are supported and rotated automatically on quota/auth failures.
# Any mixture of key formats works (classic AIza... and newer AQ.... keys):
#   GEMINI_API_KEY=key1,key2,key3            (comma / semicolon / whitespace separated)
#   GEMINI_API_KEYS=key1 key2                (explicit list)
#   GEMINI_API_KEY_2=key2                    (numbered extras, _2.._9)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Current model IDs; change these in .env if your account supports another model.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
CF_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Free-tier quota is per model, so the router rolls model-by-model when one
# bucket is exhausted (and past "model not available" per key), then provider-
# by-provider. OpenRouter free models are capped per day (50 observed); extract
# turns there disable model reasoning (reasoning models otherwise burn the
# token budget before emitting JSON). Cloudflare vision is gated by a verified
# model registry so images are never sent to a text-only model.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free
CF_FALLBACK_MODELS=@cf/meta/llama-3.2-11b-vision-instruct

# Provider order. Vision documents try the first entry that is configured and
# healthy; text documents use the text ladder. Unavailable providers are
# skipped fast instead of sleeping through cooldowns.
PROVIDER_LADDER_VISION=gemini,openrouter,cloudflare,groq
PROVIDER_LADDER_TEXT=groq,openrouter,cloudflare,gemini

# Groq free tier is token-limited (~8k tokens/minute observed): long documents
# are auto-split into page-aware parts below this character budget and merged.
GROQ_MAX_DOCUMENT_CHARS=8000
MIN_CALL_INTERVAL_SECONDS=5
REPAIR_ROUNDS=2
MAX_OUTPUT_TOKENS=24576

# Per-document wall-clock budgets bound slow free-tier queues (a stalled route
# is abandoned in favour of the next provider). Seconds.
EXTRACT_BUDGET_SECONDS=480
REPAIR_BUDGET_SECONDS=240

# Optional: explicit Tesseract binary when it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# auto: use the configured provider ladders; or force one with gemini | groq |
# openrouter | cloudflare (also available as --provider on the CLI).
PAYABLE_AI_PROVIDER=auto

# Resource controls
MAX_VISION_PAGES=20
PDF_RENDER_DPI=120
OCR_MODE=auto
OCR_WORKERS=4
OCR_PAGE_TIMEOUT_SECONDS=15
OCR_SAMPLE_PAGES=2
MAX_DOCUMENT_CHARS=90000
LLM_RETRIES=2
REPAIR_ON_MISMATCH=true
