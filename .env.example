# Copy this file to .env and paste your keys locally. Never commit .env.
# Multiple keys are supported and rotated automatically on quota/auth failures.
# Any mixture of key formats works (classic AIza... and newer AQ.... keys):
#   GEMINI_API_KEY=key1,key2,key3            (comma / semicolon / whitespace separated)
#   GEMINI_API_KEYS=key1 key2                (explicit list)
#   GEMINI_API_KEY_2=key2                    (numbered extras, _2.._9)
GEMINI_API_KEY=
GROQ_API_KEY=

# Current model IDs; change these in .env if your account supports another model.
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b

# Free-tier daily quota is per model, so the router falls back model-by-model
# when one bucket is exhausted (rolls past "model not available" per key too).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Groq free tier is token-limited (~8k tokens/minute observed): long documents
# are auto-split into page-aware parts below this character budget and merged.
GROQ_MAX_DOCUMENT_CHARS=8000
MIN_CALL_INTERVAL_SECONDS=5
REPAIR_ROUNDS=2
MAX_OUTPUT_TOKENS=24576

# Optional: explicit Tesseract binary when it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# auto: if Gemini key exists, use rendered page images first and defer full OCR; otherwise OCR all pages for Groq text extraction.
# Set OCR_MODE=all to OCR every scanned page up front, or sample/off for experimentation.
PAYABLE_AI_PROVIDER=auto

# Resource controls
MAX_VISION_PAGES=20
PDF_RENDER_DPI=120
OCR_MODE=auto
OCR_WORKERS=4
OCR_PAGE_TIMEOUT_SECONDS=15
OCR_SAMPLE_PAGES=2
MAX_DOCUMENT_CHARS=90000
LLM_RETRIES=2
REPAIR_ON_MISMATCH=true
